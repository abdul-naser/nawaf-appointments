@page "/"
@using NawafAppointment.Models
@using NawafAppointment.Services
@using NawafAppointment.Components
@using MudBlazor
@inject AppointmentService AppointmentService
@inject AppSettingsService SettingsService
@inject ReminderService ReminderService
@inject PageHeaderService HeaderService
@implements IDisposable

<MudContainer MaxWidth="MaxWidth.Large" Class="page-content">
    @{
        var next = AppointmentService.GetNextUpcoming();
        var urgent = AppointmentService.GetUpcomingWithin24Hours().ToList();
    }

    @if (urgent.Any())
    {
        <MudAlert Severity="Severity.Warning" Class="urgent-alert mt-4" Icon="@Icons.Material.Filled.NotificationImportant">
            <strong>تنبيه!</strong> يوجد @urgent.Count موعد@(urgent.Count > 1 ? "" : "") خلال 24 ساعة القادمة
        </MudAlert>
    }

    @if (next is not null)
    {
        <div class="mt-4">
            <CountdownBanner NextAppointment="next" />
        </div>
    }

    <MudGrid Spacing="3" Class="mt-4">
        <MudItem xs="6" sm="4">
            <MudPaper Elevation="0" Class="stat-card stat-blue">
                <div class="stat-icon-wrap">
                    <i class="bi bi-calendar-week"></i>
                </div>
                <div class="stat-content">
                    <MudText Typo="Typo.h4" Class="stat-value">@AppointmentService.CountThisWeek()</MudText>
                    <MudText Typo="Typo.body2" Class="stat-label">هذا الأسبوع</MudText>
                </div>
            </MudPaper>
        </MudItem>
        <MudItem xs="6" sm="4">
            <MudPaper Elevation="0" Class="stat-card stat-green">
                <div class="stat-icon-wrap">
                    <i class="bi bi-calendar-month"></i>
                </div>
                <div class="stat-content">
                    <MudText Typo="Typo.h4" Class="stat-value">@AppointmentService.CountThisMonth()</MudText>
                    <MudText Typo="Typo.body2" Class="stat-label">هذا الشهر</MudText>
                </div>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudPaper Elevation="0" Class="stat-card stat-purple">
                <div class="stat-icon-wrap">
                    <i class="bi bi-calendar-check"></i>
                </div>
                <div class="stat-content">
                    <MudText Typo="Typo.h4" Class="stat-value">@AppointmentService.Appointments.Count</MudText>
                    <MudText Typo="Typo.body2" Class="stat-label">إجمالي المواعيد</MudText>
                </div>
            </MudPaper>
        </MudItem>
    </MudGrid>

    <AppointmentListView OnAdd="OpenAddDialog" OnEdit="EditAppointment"
                         EmptyIcon="📅"
                         EmptyTitle="لا توجد مواعيد بعد"
                         EmptySubtitle="أضف أول موعد طبي لنواف لتبدأ المتابعة" />
</MudContainer>

<AppointmentDialog @ref="_dialog" Visible="_dialogVisible" VisibleChanged="OnDialogVisibleChanged"
                   AppointmentService="AppointmentService" OnSaved="Refresh" />

@code {
    private AppointmentDialog? _dialog;
    private bool _dialogVisible;

    protected override async Task OnInitializedAsync()
    {
        ConfigureHeader();
        HeaderService.RegisterAddHandler(OpenAddDialog);
        AppointmentService.OnChange += OnAppointmentsChanged;
        await AppointmentService.LoadAsync();
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
            ReminderService.Start();
    }

    private void ConfigureHeader() =>
        HeaderService.Configure(new PageHeaderOptions
        {
            Title = "المواعيد",
            Subtitle = "متابعة المواعيد الطبية",
            IconClass = "bi bi-list-ul",
            ShowAddButton = true,
            AddButtonText = "إضافة موعد"
        });

    private void OnAppointmentsChanged()
    {
        StateHasChanged();
    }

    public void Dispose()
    {
        HeaderService.UnregisterAddHandler();
        AppointmentService.OnChange -= OnAppointmentsChanged;
    }

    private async Task OpenAddDialog()
    {
        if (_dialog is not null) await _dialog.OpenForAdd();
    }

    private async Task EditAppointment(Appointment app)
    {
        if (_dialog is not null) await _dialog.OpenForEdit(app);
    }

    private void OnDialogVisibleChanged(bool visible) => _dialogVisible = visible;

    private async Task Refresh() => await AppointmentService.LoadAsync();
}
