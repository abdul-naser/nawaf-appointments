@using MudBlazor

<MudPaper Elevation="0" Class="@($"empty-state {Class}")">
    <div class="empty-state-icon">@Icon</div>
    <MudText Typo="Typo.h6" Class="empty-state-title">@Title</MudText>
    <MudText Typo="Typo.body2" Class="empty-state-subtitle">@Subtitle</MudText>
    @if (ShowAction && OnAction.HasDelegate)
    {
        <AddAppointmentButton Text="@ActionText" Class="mt-4" OnClick="OnAction" />
    }
</MudPaper>

@code {
    [Parameter] public string Icon { get; set; } = "📋";
    [Parameter] public string Title { get; set; } = "لا توجد مواعيد";
    [Parameter] public string Subtitle { get; set; } = "ابدأ بإضافة أول موعد";
    [Parameter] public string ActionText { get; set; } = "إضافة موعد";
    [Parameter] public bool ShowAction { get; set; } = true;
    [Parameter] public EventCallback OnAction { get; set; }
    [Parameter] public string? Class { get; set; }
}
